# YATS environment configuration — copy to .env and fill in.
# Every variable below is read somewhere in the codebase; none are required
# for `make demo` or the unit test suite (defaults shown where the code has one).

# ── Alpaca (market data + paper/live trading) ────────────────────────────────
# Key/secret from https://alpaca.markets (alpaca-py naming convention).
APCA_API_KEY_ID=your_alpaca_key_id
APCA_API_SECRET_KEY=your_alpaca_secret_key
# Broker REST base used by the dashboard (default: Alpaca paper endpoint).
APCA_BROKER_BASE_URL=https://paper-api.alpaca.markets/v2
# Legacy aliases read by the TS MCP layer (health check, vendors.yml probe).
ALPACA_API_KEY=your_alpaca_key_id
ALPACA_SECRET_KEY=your_alpaca_secret_key
# Secret alias probed by data.vendors via configs/vendors.yml.
ALPACA_API_SECRET=your_alpaca_secret_key

# ── financialdatasets.ai (fundamentals, insider, 13F) ────────────────────────
# API key from https://financialdatasets.ai
FINANCIALDATASETS_API_KEY=your_financialdatasets_api_key
# How many quarters of 13F institutional holdings to ingest (default: 10).
FD_13F_QUARTERS=10

# ── ThetaData (options: EOD, open interest, implied vol) ─────────────────────
# Subscriber API key — used to launch the Theta Terminal, not per-request.
THETADATA_API_KEY=your_thetadata_api_key
# Transport for options ingestion: "grpc" (default) or "rest" (local terminal).
THETADATA_TRANSPORT=grpc
# Max concurrent gRPC requests (PRO plan allows 8; default: 8).
THETADATA_MAX_CONCURRENT=8
# Override the local Theta Terminal REST address (default: http://127.0.0.1:25503/v3).
# THETADATA_BASE_URL=http://127.0.0.1:25503/v3

# ── QuestDB (canonical data plane) ───────────────────────────────────────────
# PG-wire (reads, psycopg2) — defaults match `docker compose up -d`.
QDB_PG_HOST=localhost
QDB_PG_PORT=8812
QDB_PG_USER=admin
QDB_PG_PASSWORD=quest
QDB_PG_DATABASE=qdb
# ILP (time-series writes from the TS bridge; defaults: localhost/9009).
QUESTDB_ILP_HOST=localhost
QUESTDB_ILP_PORT=9009

# ── YATS runtime ─────────────────────────────────────────────────────────────
# Comma-separated MCP roles the operator allows beyond read-only "intern",
# e.g. "researcher,risk_officer". Empty = read-only (default).
YATS_ALLOWED_ROLES=
# Root for runtime artifacts: experiments, sweeps, shadow logs (default: .yats_data).
YATS_DATA_ROOT=.yats_data
# Root for vendor flat-file drops read by the flat-file ingest job (default: .yats_data).
YATS_DATA_DIR=.yats_data
# Execution fill timing for sweep runners: "next_close" (default) or "next_open".
YATS_FILL_TIMING=next_close
# Date span override for WFO sweep runners (defaults: 2024-07-01 / 2026-07-02).
YATS_SWEEP_START=2024-07-01
YATS_SWEEP_END=2026-07-02
